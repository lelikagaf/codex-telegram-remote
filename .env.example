# Создайте бота через @BotFather и вставьте сюда его токен.
# Никогда не публикуйте заполненный файл .env.
TELEGRAM_BOT_TOKEN=

# Числовой Telegram ID единственного владельца.
# Безопасный мастер configure-owner.ps1 заполнит его автоматически.
TELEGRAM_ALLOWED_USER_ID=

# Оставьте пустым, чтобы использовать Documents\Codex текущего пользователя.
CODEX_DEFAULT_CWD=

# Обычно оставляется пустым: актуальный codex.exe будет найден автоматически.
CODEX_BINARY=

# never — не спрашивать /approve; on-request или untrusted — более строгие режимы.
CODEX_APPROVAL_POLICY=never
CODEX_FULL_ACCESS=false

TELEGRAM_NOTIFY_ON_START=true
TELEGRAM_NOTIFY_AFTER_SLEEP=false
# Максимальный размер документа в МБ. 0 или -1 — без ограничения со стороны бота.
TELEGRAM_MAX_FILE_SIZE_MB=0
RESUME_NOTIFICATION_GAP_SECONDS=120
DESKTOP_SYNC_POLL_SECONDS=3
LOG_LEVEL=info

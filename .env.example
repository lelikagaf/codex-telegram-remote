# Создайте бота через @BotFather и вставьте сюда его токен.
# Никогда не публикуйте заполненный файл .env.
TELEGRAM_BOT_TOKEN=

# Числовой Telegram ID единственного владельца.
# Безопасный мастер configure-owner.ps1 заполнит его автоматически.
TELEGRAM_ALLOWED_USER_ID=

# Оставьте пустым, чтобы использовать Documents\Codex текущего пользователя.
CODEX_DEFAULT_CWD=

# Обычно оставляется пустым: актуальный codex.exe будет найден автоматически.
CODEX_BINARY=

# never — не спрашивать /approve; on-request или untrusted — более строгие режимы.
CODEX_APPROVAL_POLICY=never
CODEX_FULL_ACCESS=false
# Даёт модели Telegram поиск, чтение и отправку сообщений в локальные чаты Codex.
CODEX_APP_TOOLS_ENABLED=false
# queue ждёт освобождения Desktop; fork сразу создаёт копию; ask спрашивает владельца.
CODEX_ACTIVE_WRITER_MODE=queue

# off — повышение Windows отключено; ask — подтверждение каждой команды в Telegram;
# always — выполнять административные команды без подтверждения Telegram.
CODEX_ELEVATION_MODE=off
CODEX_ELEVATION_TASK_NAME=Codex Telegram Elevated Helper
CODEX_ELEVATION_TIMEOUT_SECONDS=300
CODEX_ELEVATION_MAX_RUNTIME_SECONDS=600
# Обычно оставляется пустым: используется %LOCALAPPDATA%\CodexTelegramRemote\elevation.
CODEX_ELEVATION_SPOOL_PATH=

TELEGRAM_NOTIFY_ON_START=true
TELEGRAM_NOTIFY_AFTER_SLEEP=false
# Максимальный размер документа в МБ. 0 или -1 — без ограничения со стороны бота.
TELEGRAM_MAX_FILE_SIZE_MB=0
# off — не отправлять локальные файлы; workspace — только CODEX_DEFAULT_CWD;
# all — любой читаемый файл текущего пользователя Windows.
TELEGRAM_OUTGOING_FILE_ACCESS=workspace
# 0 или -1 отключает лимит размера исходящего файла со стороны бота.
TELEGRAM_OUTGOING_MAX_FILE_SIZE_MB=50
# 0 отключает лимит количества файлов из одного ответа.
TELEGRAM_OUTGOING_MAX_FILES=10
RESUME_NOTIFICATION_GAP_SECONDS=120
DESKTOP_SYNC_POLL_SECONDS=3
LOG_LEVEL=info
